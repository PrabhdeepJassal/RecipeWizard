{
  "expo": {
    "name": "Recipe Wizard",
    "description": "Recipe generating application :)",
    "slug": "RW",
    "privacy": "public",
    "sdkVersion": "51.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.3.0",
    "orientation": "portrait",
    "androidStatusBar": {
      "backgroundColor": "#000000"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 3,
      "package": "com.recipewizard",
      "permissions": []
    },
    "plugins": [
      "expo-font"
    ]
  }
}
